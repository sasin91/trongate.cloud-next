# /usr/local/etc/sanoid/sanoid.conf — Policy-driven ZFS snapshots for trongate.cloud
# Installed by infra/scripts/backups.sh with @TC_POOL@ substituted.

[@TC_POOL@/tc/services/mariadb]
    use_template = state

[@TC_POOL@/tc/services/panel]
    use_template = state

[@TC_POOL@/tc/apps]
    use_template = state
    recursive = yes

[@TC_POOL@/tc/services/custom]
    use_template = service_cache
    recursive = yes

[zroot/ROOT/default]
    use_template = os_root

#############################
# templates below this line #
#############################

[template_state]
    frequently = 0
    hourly = 24
    daily = 14
    monthly = 3
    yearly = 0
    autosnap = yes
    autoprune = yes

[template_service_cache]
    frequently = 0
    hourly = 0
    daily = 7
    monthly = 1
    yearly = 0
    autosnap = yes
    autoprune = yes

[template_os_root]
    frequently = 0
    hourly = 0
    daily = 7
    monthly = 2
    yearly = 0
    autosnap = yes
    autoprune = yes
