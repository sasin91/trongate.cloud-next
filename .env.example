# Copy this file to .env and fill in the values for your development GitHub App.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=

# Optional: set one of these to enable installation tokens and private-repository access.
GITHUB_APP_PRIVATE_KEY_FILE=
# Or supply the PEM on one line with \n between lines:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
